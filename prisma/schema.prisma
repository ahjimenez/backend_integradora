// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Estimate {
  id               String   @id @default(uuid())
  id_property      String   @db.VarChar(64)
  estimate_number  String   @db.VarChar(64)
  send_date        DateTime @db.DateTime(6)
  expiration_date  DateTime @db.DateTime(6)
  acceptation_date DateTime @db.DateTime(6)
  id_user          String   @db.VarChar(64)
  service_type     String   @db.VarChar(64)
  description      String   @db.VarChar(64)
  quantity         Decimal  @db.Decimal(8, 2)
  amount           Decimal  @db.Decimal(8, 2)
  tax_included     Boolean
  subtotal         Decimal  @db.Decimal(8, 2)
  tax_amount       Decimal  @db.Decimal(8, 2)
  total            Decimal  @db.Decimal(8, 2)
}
